{
  "name": "ai-revenue-recovery",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "server": "turbo run server --filter=@recovery/api",
    "tunnel": "ngrok http 3000",
    "tunnel:api": "yarn workspace @recovery/api tunnel",
    "worker": "turbo run dev --filter=@recovery/worker",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean",
    "docker:up": "docker compose up -d postgres redis",
    "docker:down": "docker compose down",
    "docker:full": "docker compose --profile full up --build",
    "docker:logs": "docker compose logs -f"
  },
  "packageManager": "yarn@4.12.0",
  "devDependencies": {
    "turbo": "^2.10.11",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
