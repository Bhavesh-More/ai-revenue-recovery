# Environment
NODE_ENV=development

# API
API_PORT=4000
API_HOST=0.0.0.0
API_VERSION=v1
CORS_ORIGIN=http://localhost:3000

# Database (matches docker-compose.yml service)
DATABASE_URL=postgresql://recovery:recovery@localhost:5432/recovery_dev
DATABASE_POOL_MAX=10

# Queue
REDIS_URL=redis://localhost:6379

# Agent / LLM (Ollama Cloud)
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Logging
LOG_LEVEL=info
