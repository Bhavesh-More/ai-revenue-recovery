# ─────────────────────────────────────────────────────────────────
# AI Revenue Recovery Platform — Environment Variables
# Copy this file to .env and fill in your values:  cp .env.example .env
# ─────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────
NODE_ENV=development

# ── API Server ───────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
API_VERSION=v1
CORS_ORIGIN=http://localhost:3000

# ── Database (PostgreSQL 16) ─────────────────────────────────────
# Note: Docker Compose maps host port 5433 → container port 5432
DATABASE_URL=postgresql://recovery:recovery@localhost:5433/recovery_dev
DATABASE_POOL_MAX=10

# ── Queue (Redis 7 + BullMQ) ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Agent / LLM (Ollama Cloud) ──────────────────────────────────
# Single-key mode:
OLLAMA_API_KEY=
# Multi-key pool (auto-rotation on exhaustion): add numbered keys
# OLLAMA_API_KEY_1=
# OLLAMA_API_KEY_2=
# OLLAMA_API_KEY_3=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_TIMEOUT_MS=30000

# ── Razorpay ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="RevRecovery AI <onboarding@resend.dev>"

# ── Auth (Clerk — optional, dev sandbox fallback) ────────────────
CLERK_AUTH_ENABLED=false
CLERK_SECRET_KEY=

# ── Worker ───────────────────────────────────────────────────────
WORKER_CONCURRENCY=2

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=info

# ── LangSmith Tracing (optional) ────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-revenue-recovery
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_ENVIRONMENT=development

# ── Next.js Dashboard (apps/web/.env.local) ──────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=   # (optional — dev sandbox fallback built-in)
